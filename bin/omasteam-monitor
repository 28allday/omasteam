#!/bin/bash
# omasteam-monitor — Omarchy-quattro-style system monitor panel for SteamOS.
#
# Opened from the bar's monitor chip. Same pure-userland approach as the other
# bar surfaces — stock Qt6 + org.kde.layershell via qmlscene.
#
# Read-only panel: there is no outbox, because there is nothing to click. The
# script's whole job is to keep mon-state.json fresh (~1s) while the panel is
# up; the QML polls that file and redraws the meters.
#
# Launching again while the panel is up closes it (bar-chip toggle).
set -uo pipefail

export PATH="$HOME/.local/bin:$PATH"

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
QML=""
for cand in \
  "$HERE/../artifacts/bar/omasteam-monitor.qml" \
  "$HOME/.local/share/omasteam/bar/omasteam-monitor.qml"; do
  [ -f "$cand" ] && { QML="$cand"; break; }
done
[ -n "$QML" ] || { echo "omasteam-monitor: cannot find omasteam-monitor.qml" >&2; exit 1; }

QMLSCENE="$(command -v qmlscene6 || command -v qmlscene)"
[ -n "$QMLSCENE" ] || { echo "omasteam-monitor: qmlscene not found" >&2; exit 1; }

BAR_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omasteam-bar/state.json"
MON_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omasteam-monitor"
mkdir -p "$MON_DIR"
RENDERED="$MON_DIR/omasteam-monitor.rendered.qml"
MON_STATE="$MON_DIR/mon-state.json"
CPU_PREV="$MON_DIR/cpu.prev"

# ---- single-instance toggle (PID file — see omasteam-volume for why) --------
PIDFILE="$MON_DIR/panel.pid"
oldpid="$(cat "$PIDFILE" 2>/dev/null || true)"
if [ -n "$oldpid" ] && grep -aq "omasteam-monitor.rendered.qml" "/proc/$oldpid/cmdline" 2>/dev/null; then
  kill "$oldpid" 2>/dev/null
  rm -f "$PIDFILE"
  exit 0
fi
rm -f "$PIDFILE"
rm -f "$CPU_PREV"                 # a stale sample would show one bogus first tick

# ---- close any other omasteam overlay ---------------------------------------
# The panels all anchor to the same top-right corner, so a second one used to
# bury the first: invisible, still grabbing the keyboard, still polling.
CLOSER="$HERE/omasteam-surface-close"
[ -x "$CLOSER" ] || CLOSER="$(command -v omasteam-surface-close || true)"
[ -n "$CLOSER" ] && "$CLOSER" monitor

# ---- probe the fixed hardware facts once -------------------------------------
CPU_MODEL="$(grep -m1 '^model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- \
  | sed -e 's/^ *//' -e 's/([Rr])//g' -e 's/(TM)//gI' -e 's/^AMD //' -e 's/^Intel //' \
        -e 's/ with .*$//' -e 's/ CPU @.*$//' -e 's/ *$//')"
[ -n "$CPU_MODEL" ] || CPU_MODEL="CPU"
CPU_THREADS="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 0)"

hwmon_by_name() { # $1..$n = acceptable `name` values, first match wins
  local h n want
  for want in "$@"; do
    for h in /sys/class/hwmon/hwmon*; do
      n="$(cat "$h/name" 2>/dev/null)"
      [ "$n" = "$want" ] && [ -r "$h/temp1_input" ] && { printf '%s\n' "$h/temp1_input"; return; }
    done
  done
}
# k10temp = AMD (the Deck's APU and this box); the rest are the usual fallbacks.
CPU_TEMP_FILE="$(hwmon_by_name k10temp zenpower coretemp acpitz)"
# ---- GPU backend (detected once, vendor-agnostic) ---------------------------
# This used to be `hwmon_by_name amdgpu radeon i915` plus the FIRST readable
# /sys/class/drm/card*/device/gpu_busy_percent. That is correct for exactly one
# shape of machine — a single AMD APU, i.e. an actual Deck. On anything with two
# GPUs it silently reports the wrong one: `gpu_busy_percent` is an amdgpu/xe
# attribute that NVIDIA never exposes, so on an NVIDIA-discrete + AMD-iGPU box
# the meter tracked the idle integrated chip while the discrete card did the work.
#
# GPU_KIND: nvidia (nvidia-smi) | sysfs (amdgpu/radeon/xe/i915) | "" (none found)
# Auto-pick prefers a discrete GPU. Override with
#   OMASTEAM_GPU=nvidia | amd | intel | card0 | card1 ...
GPU_KIND=""; GPU_BUSY_FILE=""; GPU_TEMP_FILE=""; GPU_VENDOR=""; GPU_MODEL=""

drm_drv() { basename "$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null)" 2>/dev/null; }

# Temp from THIS card's own hwmon, not a global name lookup — on a two-GPU box a
# global lookup happily pairs one card's load with the other card's temperature.
card_temp_file() {
  local h
  for h in "/sys/class/drm/$1/device/hwmon"/hwmon*/temp1_input; do
    [ -r "$h" ] && { printf '%s\n' "$h"; return; }
  done
}

vendor_of() {
  case "$1" in
    amdgpu|radeon) echo AMD ;;
    i915|xe)       echo Intel ;;
    nvidia|nouveau) echo NVIDIA ;;
    *)             echo "${1:-GPU}" ;;
  esac
}

# One lspci at startup for a human-readable name; absent lspci just means no label.
model_of_card() {
  local slot
  command -v lspci >/dev/null 2>&1 || return
  slot="$(basename "$(readlink -f "/sys/class/drm/$1/device" 2>/dev/null)" 2>/dev/null)"
  [ -n "$slot" ] || return
  lspci -s "${slot#0000:}" 2>/dev/null | sed 's/^[^ ]* //; s/^[^:]*: //; s/ (rev .*)$//' | head -1
}

pick_sysfs_gpu() { # $1 = driver filter ("" = any non-NVIDIA) -> cardN
  local card drv vram best="" bestv=-1 fallback=""
  for card in /sys/class/drm/card[0-9]*; do
    card="$(basename "$card")"
    case "$card" in *-*) continue ;; esac        # skip connectors (card0-HDMI-A-1)
    drv="$(drm_drv "$card")"; [ -n "$drv" ] || continue
    case "$drv" in nvidia|nouveau) continue ;; esac   # no busy% in sysfs, ever
    [ -n "${1:-}" ] && [ "$drv" != "$1" ] && continue
    # Keep the first match even without a busy file: Intel exposes no
    # gpu_busy_percent, and a temperature alone still beats an empty meter.
    [ -z "$fallback" ] && fallback="$card"
    [ -r "/sys/class/drm/$card/device/gpu_busy_percent" ] || continue
    vram="$(cat "/sys/class/drm/$card/device/mem_info_vram_total" 2>/dev/null)"
    case "${vram:-}" in ''|*[!0-9]*) vram=0 ;; esac
    # Largest VRAM wins — on a box with both, that is the discrete card.
    [ "$vram" -gt "$bestv" ] && { bestv="$vram"; best="$card"; }
  done
  printf '%s\n' "${best:-$fallback}"
}

use_sysfs_card() {
  local card="$1" drv
  [ -n "$card" ] || return 1
  [ -d "/sys/class/drm/$card/device" ] || return 1   # a name that isn't a card
  drv="$(drm_drv "$card")"
  [ -n "$drv" ] || return 1                          # bound to no driver
  # Refuse NVIDIA here. It publishes neither busy% nor a DRM hwmon, so a "sysfs
  # NVIDIA" would report no load and then borrow some OTHER card's temperature.
  # Returning 1 lets an explicitly named NVIDIA card fall through to nvidia-smi.
  case "$drv" in nvidia|nouveau) return 1 ;; esac
  GPU_KIND=sysfs
  GPU_VENDOR="$(vendor_of "$drv")"
  GPU_MODEL="$(model_of_card "$card")"
  [ -r "/sys/class/drm/$card/device/gpu_busy_percent" ] \
    && GPU_BUSY_FILE="/sys/class/drm/$card/device/gpu_busy_percent"
  GPU_TEMP_FILE="$(card_temp_file "$card")"
  # Only ever fall back to a hwmon of the SAME driver. The old code fell back to
  # `amdgpu radeon i915` whatever the card was, which is how one GPU's load ended
  # up paired with another GPU's temperature in the first place.
  [ -n "$GPU_TEMP_FILE" ] || GPU_TEMP_FILE="$(hwmon_by_name "$drv")"
  return 0
}

detect_gpu() {
  local want="${OMASTEAM_GPU:-auto}" card
  # An unrecognised override must behave like `auto`, not silently drop through
  # to the sysfs branch and pick a different GPU than auto would have.
  case "$want" in nvidia|amd|intel|auto|card[0-9]*) ;; *) want=auto ;; esac
  case "$want" in
    card[0-9]*) use_sysfs_card "$want" && return
                # use_sysfs_card refuses NVIDIA, so landing here means the named
                # card is NVIDIA (or does not exist) — try nvidia-smi for it.
                want=nvidia ;;
  esac

  if [ "$want" = nvidia ] || [ "$want" = auto ]; then
    if command -v nvidia-smi >/dev/null 2>&1 \
       && nvidia-smi --query-gpu=name --format=csv,noheader >/dev/null 2>&1; then
      GPU_KIND=nvidia; GPU_VENDOR=NVIDIA
      GPU_MODEL="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
      return
    fi
    [ "$want" = nvidia ] && return          # asked for it explicitly, none there
  fi

  case "$want" in
    amd)   use_sysfs_card "$(pick_sysfs_gpu amdgpu)" || use_sysfs_card "$(pick_sysfs_gpu radeon)" ;;
    intel) use_sysfs_card "$(pick_sysfs_gpu i915)"   || use_sysfs_card "$(pick_sysfs_gpu xe)" ;;
    *)     use_sysfs_card "$(pick_sysfs_gpu)" ;;
  esac
  return 0
}
detect_gpu

gpu_sample() { # -> "<pct|null> <temp|null>", whichever the chosen backend can answer
  local pct=null temp=null out
  case "$GPU_KIND" in
    nvidia)
      # ~20ms, and this panel only runs while it is open. NVIDIA publishes no
      # busy counter in sysfs at all, so there is no cheaper source.
      out="$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu \
               --format=csv,noheader,nounits 2>/dev/null | head -1)"
      pct="${out%%,*}"; temp="${out##*,}"
      pct="${pct//[[:space:]]/}"; temp="${temp//[[:space:]]/}"
      case "${pct:-}"  in ''|*[!0-9]*)  pct=null ;;  esac
      case "${temp:-}" in ''|*[!0-9-]*) temp=null ;; esac ;;
    sysfs)
      if [ -n "$GPU_BUSY_FILE" ]; then
        pct="$(cat "$GPU_BUSY_FILE" 2>/dev/null)"
        case "${pct:-}" in ''|*[!0-9]*) pct=null ;; esac
      fi
      temp="$(read_temp "$GPU_TEMP_FILE")" ;;
  esac
  printf '%s %s\n' "$pct" "$temp"
}

read_temp() { # millidegrees -> whole degrees, or "null"
  local v
  [ -n "$1" ] && v="$(cat "$1" 2>/dev/null)"
  case "${v:-}" in ''|*[!0-9-]*) echo null ;; *) echo $((v / 1000)) ;; esac
}

# ---- sampling ----------------------------------------------------------------
cpu_pct() {
  # Same /proc/stat delta the bar daemon uses, against our own prev file so the
  # two samplers can't disturb each other.
  local _n user nice sys idle iowait irq softirq steal total idled pct=0
  local ptotal=0 pidle=0 dt di
  read -r _n user nice sys idle iowait irq softirq steal _ < /proc/stat
  total=$((user + nice + sys + idle + iowait + irq + softirq + steal))
  idled=$((idle + iowait))
  read -r ptotal pidle < "$CPU_PREV" 2>/dev/null || true
  case "${ptotal:-}${pidle:-}" in *[!0-9]*|"") ptotal=0; pidle=0 ;; esac
  dt=$((total - ptotal)); di=$((idled - pidle))
  [ "$ptotal" -gt 0 ] && [ "$dt" -gt 0 ] && pct=$(( (100 * (dt - di)) / dt ))
  [ "$pct" -lt 0 ] && pct=0
  [ "$pct" -gt 100 ] && pct=100
  printf '%s %s\n' "$total" "$idled" > "$CPU_PREV" 2>/dev/null
  echo "$pct"
}

top_procs() {
  # top's FIRST iteration reports CPU% averaged since boot, which makes every
  # busy-looking process look identical — so take two iterations and keep the
  # second block (awk resets the row counter at each header, so the rows left
  # standing at END are the last block's).
  command -v top >/dev/null || return
  top -bn2 -d 0.3 -w 200 2>/dev/null | awk '
    /^ *PID +USER/ { n = 0; next }
    $1 ~ /^[0-9]+$/ && NF >= 12 { rows[++n] = $0 }
    END {
      shown = 0
      for (i = 1; i <= n && shown < 3; i++) {
        # Count fields from the END (… S %CPU %MEM TIME+ COMMAND): the leading
        # columns vary in width, the trailing ones never do.
        c = split(rows[i], f, " ")
        name = f[c]; cpu = f[c-3]; mem = f[c-2]
        if (name == "top" || name == "") continue
        printf "%s\t%s\t%s\n", name, cpu, mem
        shown++
      }
    }'
}

regen_state() {
  local tmp cpu ctemp gtemp gbusy memtotal memavail swaptotal swapfree up load
  tmp=$(mktemp "$MON_STATE.XXXXXX") || return

  cpu="$(cpu_pct)"
  ctemp="$(read_temp "$CPU_TEMP_FILE")"
  read -r gbusy gtemp <<<"$(gpu_sample)"

  memtotal=0; memavail=0; swaptotal=0; swapfree=0
  while read -r key val _; do
    case "$key" in
      MemTotal:)     memtotal=$val ;;
      MemAvailable:) memavail=$val ;;
      SwapTotal:)    swaptotal=$val ;;
      SwapFree:)     swapfree=$val; break ;;
    esac
  done < /proc/meminfo

  read -r load _ < /proc/loadavg
  up="$(uptime -p 2>/dev/null)"

  # Disk: whichever filesystem $HOME lives on — on SteamOS that's the writable
  # partition, which is the only one whose fill level a user can act on.
  local dused=0 dsize=0 dmount="/"
  read -r dused dsize dmount < <(df -B1 --output=used,size,target "$HOME" 2>/dev/null | tail -1)
  case "${dused:-}" in ''|*[!0-9]*) dused=0; dsize=0; dmount="/" ;; esac

  top_procs | jq -R -s \
      --argjson cpu "$cpu" --argjson ctemp "$ctemp" \
      --argjson gbusy "$gbusy" --argjson gtemp "$gtemp" \
      --arg gvendor "$GPU_VENDOR" --arg gmodel "$GPU_MODEL" \
      --argjson memtotal "$((memtotal * 1024))" --argjson memused "$(( (memtotal - memavail) * 1024 ))" \
      --argjson swaptotal "$((swaptotal * 1024))" --argjson swapused "$(( (swaptotal - swapfree) * 1024 ))" \
      --argjson dused "${dused:-0}" --argjson dsize "${dsize:-0}" --arg dmount "${dmount:-/}" \
      --arg model "$CPU_MODEL" --argjson threads "${CPU_THREADS:-0}" \
      --arg load "$load" --arg up "$up" \
    '{ cpu:  { pct: $cpu, temp: $ctemp, model: $model, threads: $threads, load: $load },
       gpu:  { pct: $gbusy, temp: $gtemp, vendor: $gvendor, model: $gmodel },
       mem:  { used: $memused, total: $memtotal },
       swap: { used: $swapused, total: $swaptotal },
       disk: { used: $dused, total: $dsize, mount: $dmount },
       uptime: $up,
       procs: [ split("\n")[] | select(length > 0) | split("\t")
                | { name: .[0], cpu: (.[1] | tonumber? // 0), mem: (.[2] | tonumber? // 0) } ] }' \
    > "$tmp" && mv -f "$tmp" "$MON_STATE" || rm -f "$tmp"
}

# ---- render self-contained temp QML (values via ENVIRON — see omasteam-menu)
render() {
  QML_STATE="$BAR_STATE" QML_MONSTATE="$MON_STATE" awk '
    function subst(line, ph, v,    out, p) {
      out = ""
      p = index(line, ph)
      while (p > 0) {
        out = out substr(line, 1, p - 1) v
        line = substr(line, p + length(ph))
        p = index(line, ph)
      }
      return out line
    }
    { line = $0
      line = subst(line, "@@STATE@@",    ENVIRON["QML_STATE"])
      line = subst(line, "@@MONSTATE@@", ENVIRON["QML_MONSTATE"])
      print line
    }' "$QML" > "$RENDERED"
}

# ---- run --------------------------------------------------------------------
regen_state                      # first sample: CPU% reads 0 (no delta yet)
render

QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
QT_WAYLAND_SHELL_INTEGRATION=layer-shell \
QML_XHR_ALLOW_FILE_READ=1 \
  "$QMLSCENE" "$RENDERED" >/dev/null 2>&1 &
QPID=$!
echo "$QPID" > "$PIDFILE"

# Resample about once a second while the panel is up. regen_state takes ~0.3s
# (top's two iterations), so it runs in the background — a foreground call
# would stretch the loop and make the CPU delta window uneven. Never start a
# second one on top of a slow one: they'd race on cpu.prev and the percentage
# would jitter. (RPID starts EMPTY, not 0 — `kill -0 0` signals the whole
# process group and would always "succeed", blocking the first sample.)
RPID=""
while kill -0 "$QPID" 2>/dev/null; do
  if [ -z "$RPID" ] || ! kill -0 "$RPID" 2>/dev/null; then
    regen_state &
    RPID=$!
  fi
  sleep 1
done
rm -f "$PIDFILE"
