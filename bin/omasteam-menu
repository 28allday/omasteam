#!/bin/bash
# omasteam-menu — Omarchy-style system menu for SteamOS + KDE (Meta+Alt+Space).
#
# Pure userland: SteamOS's stock Qt6 + org.kde.layershell, run by qmlscene. This
# script is BOTH the launcher and the backend/dispatcher — plain QML can't spawn
# processes, so the overlay pushes a leaf action-id to a SQLite outbox and this
# script (which blocks until the overlay closes) runs the real command.
#
# Meta+Alt+Space toggles: launching again while a menu is up closes it.
#
# Usage:  omasteam-menu           show the menu (toggle), then run the choice
#         omasteam-menu --print   show the menu, print the chosen id, don't run
set -uo pipefail

# The graphical session's PATH doesn't include ~/.local/bin (that's a .bashrc
# addition; a KDE global shortcut never sources it). omasteam-theme / omasteam-bar
# live there, so make sure we can find them.
export PATH="$HOME/.local/bin:$PATH"

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
QML=""
for cand in \
  "$HERE/../artifacts/bar/omasteam-menu.qml" \
  "$HOME/.local/share/omasteam/bar/omasteam-menu.qml"; do
  [ -f "$cand" ] && { QML="$cand"; break; }
done
[ -n "$QML" ] || { echo "omasteam-menu: cannot find omasteam-menu.qml" >&2; exit 1; }

QMLSCENE="$(command -v qmlscene6 || command -v qmlscene)"
[ -n "$QMLSCENE" ] || { echo "omasteam-menu: qmlscene not found" >&2; exit 1; }

# Palette comes from the bar daemon's state.json (menu reuses the live theme).
BAR_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omasteam-bar/state.json"
MENU_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omasteam-menu"
mkdir -p "$MENU_DIR"
RENDERED="$MENU_DIR/omasteam-menu.rendered.qml"
THEMES_DIR="$HOME/.config/omasteam/themes"

MODE=run
[ "${1:-}" = "--print" ] && MODE=print

# ---- single-instance toggle (PID file, like the panels) ---------------------
# NOT pgrep/pkill -f: that matches ANY process whose command line happens to
# contain the pattern — an editor with the rendered file open, a grep, a test
# shell — so an unrelated process could both block this launcher and get killed
# by it. The PID is verified against /proc instead, which cannot mismatch.
PIDFILE="$MENU_DIR/panel.pid"
if [ "$MODE" = run ]; then
  oldpid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "${oldpid:-}" ] && grep -aq "omasteam-menu.rendered.qml" "/proc/$oldpid/cmdline" 2>/dev/null; then
    kill "$oldpid" 2>/dev/null
    rm -f "$PIDFILE"
    exit 0
  fi
  rm -f "$PIDFILE"
fi

# ---- close any other omasteam overlay ---------------------------------------
# Two overlays at once means two keyboard grabs and a card the user can't see
# (see omasteam-surface-close).
CLOSER="$HERE/omasteam-surface-close"
[ -x "$CLOSER" ] || CLOSER="$(command -v omasteam-surface-close || true)"
[ -n "$CLOSER" ] && [ "$MODE" = run ] && "$CLOSER" menu

# ---- dynamic Style > Themes level ------------------------------------------
themes_json() {
  local first=1 out="[" name d
  [ -d "$THEMES_DIR" ] || { printf '[]'; return; }
  for d in "$THEMES_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    name="${name//\\/\\\\}"; name="${name//\"/\\\"}"   # JSON-escape
    if [ $first -eq 1 ]; then first=0; else out+=","; fi
    out+="\"$name\""
  done
  out+="]"
  printf '%s' "$out"
}
THEMESJSON="$(themes_json)"
CURRENT_THEME="$(cat "$THEMES_DIR/.current" 2>/dev/null || true)"
# CURRENT_THEME lands inside a JS string literal — escape it like themes_json does.
CURRENT_THEME="${CURRENT_THEME//\\/\\\\}"; CURRENT_THEME="${CURRENT_THEME//\"/\\\"}"

# ---- render self-contained temp QML (qmlscene can't take argv/env) ----------
# Literal replacement via awk + ENVIRON (matches omasteam-apps): sed treats
# `&`/`\` in the replacement specially and its delimiter can collide with a
# theme name, and `awk -v` escape-processes its values. ENVIRON is verbatim.
render() {
  QML_STATE="$BAR_STATE" QML_THEMES="$THEMESJSON" QML_CURRENT="$CURRENT_THEME" awk '
    function subst(line, ph, v,    out, p) {
      out = ""
      p = index(line, ph)
      while (p > 0) {
        out = out substr(line, 1, p - 1) v
        line = substr(line, p + length(ph))
        p = index(line, ph)
      }
      return out line
    }
    { line = $0
      line = subst(line, "@@STATE@@",         ENVIRON["QML_STATE"])
      line = subst(line, "@@THEMES@@",        ENVIRON["QML_THEMES"])
      line = subst(line, "@@CURRENT_THEME@@", ENVIRON["QML_CURRENT"])
      print line
    }' "$QML" > "$RENDERED"
}
render

# ---- SQLite outbox (table `menu_outbox`; the bar daemon only drains `outbox`) -
# read the chosen id(s); ACTION=1 also deletes and echoes them, ACTION=0 just
# clears (drop anything stale from a crashed session before we show the menu).
drain_outbox() { # $1 = 1 to emit, 0 to purge silently
  command -v sqlite3 >/dev/null || return
  local db c emit="$1"
  while IFS= read -r db; do
    [ -f "$db" ] || continue
    sqlite3 "$db" "SELECT 1 FROM sqlite_master WHERE type='table' AND name='menu_outbox' LIMIT 1;" 2>/dev/null | grep -q 1 || continue
    if [ "$emit" = 1 ]; then
      while IFS= read -r c; do [ -n "$c" ] && printf '%s\n' "$c"; done \
        < <(sqlite3 "$db" "SELECT cmd FROM menu_outbox ORDER BY id;" 2>/dev/null)
    fi
    sqlite3 "$db" "DELETE FROM menu_outbox;" 2>/dev/null
  done < <(find "$HOME/.local/share/QtProject" -path '*QML/OfflineStorage/Databases/*.sqlite' 2>/dev/null)
}

# ---- action dispatch -------------------------------------------------------
# NOTE: `logout` / `return-to-gaming` mirror omasteam-bar-daemon's run_cmd. A
# future refactor could share a bin/omasteam-actions lib between the two.
launch() { setsid "$@" >/dev/null 2>&1 </dev/null & }
run_menu_cmd() {
  local cmd="$1" name
  case "$cmd" in
    # KDE settings modules: every settings leaf is `kcm:<module>` → open it in
    # kcmshell6. One generic case covers the whole systemsettings tree.
    kcm:*)          launch kcmshell6 "${cmd#kcm:}" ;;
    # Full KDE System Settings app (the "Open Full System Settings" leaf).
    settings)       if command -v systemsettings >/dev/null; then launch systemsettings
                    else launch kcmshell6 kcm_landingpage; fi ;;
    # spectacle background captures save to the default screenshots location.
    shot-region)    launch spectacle -r -b -n ;;
    shot-window)    launch spectacle -a -b -n ;;
    shot-full)      launch spectacle -f -b -n ;;
    record)         launch spectacle -R region ;;
    wallpaper-next) omasteam-theme wallpaper next 2>/dev/null ;;
    theme-set:*)    name="${cmd#theme-set:}"
                    [ -n "$name" ] && omasteam-theme set "$name" 2>/dev/null ;;   # bar re-themes on its next tick
    # Wi-Fi uses the NetworkManager applet (nicer picker than the kcm editor).
    wifi)           launch plasmawindowed org.kde.plasma.networkmanagement ;;
    lock)           loginctl lock-session 2>/dev/null \
                      || qdbus6 org.kde.screensaver /ScreenSaver Lock 2>/dev/null ;;
    suspend)        systemctl suspend ;;
    logout)         qdbus6 org.kde.LogoutPrompt /LogoutPrompt promptLogout 2>/dev/null \
                      || qdbus6 org.kde.ksmserver /KSMServer logout 1 0 3 2>/dev/null ;;
    restart)        qdbus6 org.kde.LogoutPrompt /LogoutPrompt promptReboot 2>/dev/null \
                      || systemctl reboot ;;
    shutdown)       qdbus6 org.kde.LogoutPrompt /LogoutPrompt promptShutDown 2>/dev/null \
                      || systemctl poweroff ;;
    return-to-gaming)
                    if [ "$(steamosctl get-default-login-mode 2>/dev/null)" = desktop ]; then
                      steamosctl switch-to-game-mode 2>/dev/null &
                    else
                      qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null &
                    fi ;;
    "" ) : ;;   # dismissed / no-op leaf
    *  ) echo "omasteam-menu: unknown action '$cmd'" >&2 ;;
  esac
}

# ---- run --------------------------------------------------------------------
# The Qt env vars are scoped to the qmlscene invocation, NOT exported: the
# dispatcher's launch() inherits our environment, and a leaked
# QT_WAYLAND_SHELL_INTEGRATION=layer-shell turns every Qt app we launch
# (kcmshell6, systemsettings, plasmawindowed ...) into a layer-shell surface
# stretched over the whole output — "everything opens full screen".
# QML_XHR_ALLOW_FILE_READ: QML XMLHttpRequest refuses file:// reads without it.
drain_outbox 0                     # purge any stale choice first
QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
QT_WAYLAND_SHELL_INTEGRATION=layer-shell \
QML_XHR_ALLOW_FILE_READ=1 \
  "$QMLSCENE" "$RENDERED" >/dev/null 2>&1 &
# Backgrounded only so the PID can be recorded for the single-instance toggle
# and for omasteam-surface-close; `wait` restores the blocking behaviour.
QPID=$!
[ "$MODE" = run ] && echo "$QPID" > "$PIDFILE"
wait "$QPID"
rm -f "$PIDFILE"

# Dispatch whatever was chosen (usually one id; nothing if dismissed).
while IFS= read -r choice; do
  [ -z "$choice" ] && continue
  if [ "$MODE" = print ]; then printf '%s\n' "$choice"; else run_menu_cmd "$choice"; fi
done < <(drain_outbox 1)
