#!/usr/bin/env bash
# Re-assert omasteam launcher shortcuts. Custom ~/.local .desktop launchers created during
# install are invisible to that session's kglobalaccel (login-time ksycoca snapshot), so they
# load next login "reserved but not grabbed" — a daemon setForeignShortcut establishes the
# real grab. System .desktops (dolphin/krunner) are always cached, so they're skipped — but
# a flatpak browser installed in the same session as omasteam has the same staleness problem,
# so the browser is re-asserted here too.
sleep 4   # let kglobalaccel + ksycoca settle after login
# doRegister first: it CREATES the launcher's kglobalaccel component so the grab
# attaches even for a .desktop added after this session's kglobalaccel started
# (it only reads the [services] file at session start). setForeignShortcut then
# assigns the key. Together they establish the grab live, no second relogin.
b(){ dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /kglobalaccel \
       org.kde.KGlobalAccel.doRegister array:string:"$1","_launch","$2","$2" >/dev/null 2>&1
     dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /kglobalaccel \
       org.kde.KGlobalAccel.setForeignShortcut array:string:"$1","_launch","$2","$2" array:int32:"$3" >/dev/null 2>&1; }
# Krohnkite re-registers "Set master" on Meta+Return at each login; it's a kwin-component
# action so it beats the kitty.desktop launcher and leaves _launch= empty. Free it first.
dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /kglobalaccel \
  org.kde.KGlobalAccel.setForeignShortcut \
  array:string:"kwin","KrohnkiteSetMaster","KWin","Krohnkite: Set master" array:int32: >/dev/null 2>&1
# Re-assert the Krohnkite resize binds. install.sh already sets these through the
# daemon, but they race its settings sync: on this Deck's install three of the four
# landed and KrohnkiteShrinkHeight came out empty, with nothing else holding
# Meta+Ctrl+J — a lost write, not a conflict. They're cheap to re-state, and doing
# it here means a bind lost that way heals itself at the next login instead of
# needing a hand-run dbus call.
k(){ dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /kglobalaccel \
       org.kde.KGlobalAccel.setForeignShortcut \
       array:string:"kwin","$1","KWin","$2" array:int32:"$3" >/dev/null 2>&1; }
k KrohnkiteShrinkWidth  "Krohnkite: Shrink Width"  335544392   # Meta+Ctrl+H
k KrohnkitegrowWidth    "Krohnkite: Grow Width"    335544396   # Meta+Ctrl+L
k KrohnkiteShrinkHeight "Krohnkite: Shrink Height" 335544394   # Meta+Ctrl+J
k KrohnkiteGrowHeight   "Krohnkite: Grow Height"   335544395   # Meta+Ctrl+K
b kitty.desktop                   "Launch kitty"   285212676   # Super+Return
b omarchy-btop.desktop            "btop"           268435540   # Super+T
b omarchy-nvim.desktop            "Neovim"         268435534   # Super+N
b omasteam-wallpaper-next.desktop "Next Wallpaper" 335544352   # Meta+Ctrl+Space
b omasteam-menu.desktop           "omasteam Menu"  402653216   # Meta+Alt+Space
# krunner's .desktop declares Meta+Space as a DEFAULT, so kglobalaccel re-grants
# it on every login unless it's pushed off explicitly. omasteam no longer wants
# that key for itself (the app launcher moved into the system menu), but a
# desktop where Meta+Space silently pops KRunner isn't what this shell is for —
# so keep pinning KRunner to Alt+Space only and leave Meta+Space free.
b org.kde.krunner.desktop         "KRunner"        134217760   # Alt+Space only
BROWSER="$(xdg-settings get default-web-browser 2>/dev/null)"
b "${BROWSER:-org.mozilla.firefox.desktop}"        "Web Browser"    268435522   # Meta+B
