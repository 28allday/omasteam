[Desktop Entry]
Type=Application
Name=omasteam bar
Comment=Omarchy-style top bar (QML layer-shell) for SteamOS + KDE
Exec=omasteam-bar
Icon=steamdeck-gaming-return
Terminal=false
# KDE Wayland session only — the bar is a wlr-layer-shell surface.
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
NoDisplay=true
